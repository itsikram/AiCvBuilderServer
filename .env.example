# AI CV Builder BD API configuration.
# Copy to server/.env for local development. In production (cPanel, Render, ...)
# set these in the host's environment-variable UI, never in committed files.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
# development | production | test
NODE_ENV=development
# Port the API listens on (cPanel/Passenger sets PORT itself)
PORT=5000
# Canonical public origin (no trailing slash). Used for canonical URLs, sitemap,
# share links, emails, CORS and the www/http -> https apex redirect.
SITE_URL=http://localhost:5173
# Optional: where email links point if it differs from SITE_URL (for example the Vite dev server)
CLIENT_URL=
# Optional: extra comma-separated origins allowed by CORS (the www/apex twin of SITE_URL is automatic)
ALLOWED_ORIGINS=
# Optional: cookie domain for the refresh token, e.g. .aicvbuilderbd.online (leave empty for host-only)
COOKIE_DOMAIN=
# Set to true in production behind cPanel/Render to 301 http->https and www->apex
FORCE_CANONICAL_HOST=false
# Optional: absolute path to the built client (defaults to ../client/dist next to the server)
CLIENT_DIST_PATH=
APP_NAME=AI CV Builder BD

# ---------------------------------------------------------------------------
# Database (MongoDB Atlas in production; shared hosting cannot run MongoDB)
# ---------------------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017/aicvbuilderbd
# Development only: start a throwaway in-memory MongoDB instead of MONGODB_URI
USE_MEMORY_DB=false
# Optional: DNS servers for mongodb+srv:// lookups when the local resolver fails (e.g. 8.8.8.8,1.1.1.1)
DNS_SERVERS=

# ---------------------------------------------------------------------------
# Auth (generate each secret with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
# ---------------------------------------------------------------------------
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d
# Optional Google Sign-In (Web client ID from Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Used only by `npm run seed` to create the first admin (min 10 characters)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Gemini AI (keys from https://aistudio.google.com/apikey)
# ---------------------------------------------------------------------------
# Comma-separated keys; requests rotate between them and skip rate-limited keys
GEMINI_API_KEYS=
# Legacy single key, used only when GEMINI_API_KEYS is empty
GEMINI_API_KEY=
# Model id. Flash-Lite is the cheapest; use gemini-2.5-flash for higher quality.
GEMINI_MODEL=gemini-2.5-flash-lite
# Per-request timeout in milliseconds
GEMINI_TIMEOUT_MS=30000
# Retries on 429/5xx/timeouts before giving up (exponential backoff)
GEMINI_MAX_RETRIES=3

# ---------------------------------------------------------------------------
# AI quotas (admins can override these in Admin -> Settings)
# ---------------------------------------------------------------------------
AI_DAILY_QUOTA_FREE=10
AI_DAILY_QUOTA_PREMIUM=100

# ---------------------------------------------------------------------------
# Cache (optional). Leave REDIS_URL empty or DISABLE_REDIS=true on shared hosting;
# the app then uses an in-memory cache.
# ---------------------------------------------------------------------------
REDIS_URL=
DISABLE_REDIS=true

# ---------------------------------------------------------------------------
# PDF import
# ---------------------------------------------------------------------------
# Optional pdftxt.dev key (pdfbot_ prefix). Without it, text is extracted locally.
PDFTXT_API_KEY=

# ---------------------------------------------------------------------------
# Cloudinary (optional: profile photos, blog covers, keeping uploaded CV files)
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------------------
# Email (optional: verification and password reset)
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=AI CV Builder BD <noreply@aicvbuilderbd.online>

# ---------------------------------------------------------------------------
# Payments (optional)
# ---------------------------------------------------------------------------
SSL_STORE_ID=
SSL_STORE_PASS=
SSL_IS_LIVE=false
SSL_SUCCESS_URL=http://localhost:5173/billing/success
SSL_FAIL_URL=http://localhost:5173/billing/fail
SSL_CANCEL_URL=http://localhost:5173/billing/cancel
SSL_IPN_URL=http://localhost:5000/api/v1/payments/sslcommerz/ipn

# bKash / Nagad (structure ready, not live)
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_IS_SANDBOX=true
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_NUMBER=
NAGAD_PUBLIC_KEY=
NAGAD_PRIVATE_KEY=
NAGAD_IS_SANDBOX=true
