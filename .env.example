NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB
MONGODB_URI=mongodb://admin:changeme@localhost:27017/chakricv?authSource=admin

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-secret-key
JWT_REFRESH_EXPIRES_IN=30d

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Gemini AI
# Single API key (legacy)
GEMINI_API_KEY=your-gemini-api-key
# Multiple API keys (comma-separated for rotation & fallback)
GEMINI_API_KEYS=your-gemini-api-key-1,your-gemini-api-key-2,your-gemini-api-key-3
GEMINI_MODEL=gemini-2.5-flash

# PDF text extraction (pdftxt.dev)
# Generate a key with the pdfbot_ prefix, e.g. pdfbot_myapp_12345
PDFTXT_API_KEY=pdfbot_your_key_here

# Redis
REDIS_URL=redis://localhost:6379

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Email (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=ChakriCV <noreply@chakricv.com>

# SSLCommerz
SSL_STORE_ID=your-store-id
SSL_STORE_PASS=your-store-password
SSL_IS_LIVE=false
SSL_SUCCESS_URL=http://localhost:5173/billing/success
SSL_FAIL_URL=http://localhost:5173/billing/fail
SSL_CANCEL_URL=http://localhost:5173/billing/cancel
SSL_IPN_URL=http://localhost:5000/api/v1/payments/sslcommerz/ipn

# bKash (structure ready)
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_IS_SANDBOX=true

# Nagad (structure ready)
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_NUMBER=
NAGAD_PUBLIC_KEY=
NAGAD_PRIVATE_KEY=
NAGAD_IS_SANDBOX=true

# App
APP_NAME=ChakriCV
APP_URL=http://localhost:5173
